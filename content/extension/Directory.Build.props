<?xml version="1.0" encoding="utf-8" ?>
<Project>
    <PropertyGroup>
        <GamePath>C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GamePath>
        <BepInExAssembliesPath>$(GamePath)\BepInEx\core</BepInExAssembliesPath>
        <GameAssemblyPath>$(GamePath)\Gorilla Tag_Data\Managed</GameAssemblyPath>
        <MonkeFramesAssemblyPath>$(GamePath)\BepInEx\plugins\MonkeFrames</BepInExAssembliesPath>
    </PropertyGroup>

    <PropertyGroup>
        <DocumentsPath>$([System.Environment]::GetFolderPath([System.Environment+SpecialFolder]::MyDocuments))</MyDocumentsPath>
        <ExtensionsPath>$([System.IO.Path]::Combine($(DocumentsPath), 'MonkeFrames', 'extensions'))</ExtensionsPath>
    </PropertyGroup>
</Project>